{
  "name": "dataquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node prisma/seed.mjs",
    "db:content": "node prisma/apply-problems.mjs",
    "db:lessons": "node prisma/apply-lessons.mjs",
    "db:reset": "prisma migrate reset --force && node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON prisma/check-content.mjs",
    "verify:lesson": "node prisma/verify-lesson.mjs",
    "syllabus": "node prisma/check-syllabus.mjs",
    "db:chapters": "node prisma/apply-chapters.mjs",
    "test:8085": "node prisma/test-asm8085.mjs",
    "test:errors": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-error-help.mjs",
    "test:sklearn": "node scripts/test-sklearn.mjs",
    "test:sql-help": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-sql-help.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "linkedom": "^0.18.13",
    "next": "16.2.10",
    "prisma": "^6.19.3",
    "pyodide": "^314.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
