// DataQuest — data model
// A data-science learning platform: tracks (phases) -> lessons -> problems,
// with real per-user progress, submissions, XP and streaks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @default("")
  role         String   @default("Aspiring Data Analyst")
  xp           Int      @default(0)
  // No streak column. It was a seeded constant nothing ever wrote to: the demo
  // account showed 12 days against three submissions, and every real signup was
  // told to keep its "0-day streak" alive forever. Derived from submissions in
  // lib/progress.ts now, exactly like Track.status was.
  createdAt    DateTime @default(now())

  // Onboarding. All optional — a student who skips still gets an account.
  gender         String? // "male" | "female" | "unspecified"
  institution    String? // class or college, free text
  interestsCsv   String    @default("")
  language       String    @default("en") // stated preference; no content varies by it yet
  sessionVersion Int       @default(0) // bumped on logout, invalidating every issued cookie
  onboardedAt    DateTime?
  welcomedAt     DateTime? // set the first time the welcome plays, so it plays once

  // Profile — what a student writes about themselves. All optional: an account
  // that never opens /profile is complete, it just has nothing written on it.
  //
  // No avatar URL. A photo upload means blob storage (a bill) and moderation;
  // `avatarEmoji` is one emoji from a fixed set, and the colour behind it is
  // derived from the name the way subject hues already are.
  bio         String?
  goal        String? // "Current Goal" — what they are working towards
  avatarEmoji String?

  lessonProgress LessonProgress[]
  submissions    Submission[]
  attempts       ProblemAttempt[]
  quizAnswers    QuizAnswer[]
  errorEvents    ErrorEvent[]
  challenges     Challenge[]
  challengeRuns  ChallengeAttempt[]
  notes          Note[]
  sessions       StudySession[]
  notebook       NotebookEntry[]
  roomMembers    RoomMember[]
  roomMessages   RoomMessage[]
  hostedRooms    Room[]             @relation("RoomHost")
  feedback       Feedback[]
}

model Track {
  id         String  @id @default(cuid())
  slug       String  @unique
  order      Int
  title      String
  subtitle   String
  icon       String  @default("Py")
  whyText    String  @default("")
  weeks      String  @default("")
  level      String  @default("Beginner")
  milestone  String  @default("")
  toolsCsv   String  @default("")
  // Just the syllabus skill names: ["Variables", "Loops", ...]. Whether a skill is
  // done, and whether a track is done/now/locked, are per-user and derived in
  // lib/progress.ts. They used to be stored here, which meant every user saw the
  // same seeded "Python done, 33% job-ready" regardless of what they'd actually done.
  skillsJson String  @default("[]")
  checkpoint String? // e.g. "Data Analyst · ₹4-8 LPA"

  lessons  Lesson[]
  chapters Chapter[]
}

// The level the vision requires and the schema did not have:
// Subject -> Chapter -> Topic -> { lesson, visualization, quiz, problems }.
// See docs/ARCHITECTURE.md. `Track` is the Subject in all but name, and
// `Lesson` is the Topic.
//
// Added additively on purpose. Lesson.chapterId is nullable and Lesson.trackId
// stays, so every existing page keeps working untouched and no student's
// progress moves. Chapters can then be split for real, one subject at a time,
// instead of in one risky rewrite.
model Chapter {
  id      String @id @default(cuid())
  slug    String @unique
  order   Int
  title   String
  summary String @default("")
  trackId String
  track   Track  @relation(fields: [trackId], references: [id])

  lessons Lesson[]

  @@index([trackId, order])
}

model Lesson {
  id          String @id @default(cuid())
  slug        String @unique
  order       Int
  title       String
  minutes     Int    @default(10)
  level       String @default("Beginner")
  contentJson String @default("[]") // ordered content blocks
  trackId     String
  track       Track  @relation(fields: [trackId], references: [id])

  // Nullable while chapters are introduced subject by subject. A lesson with no
  // chapter yet still belongs to its subject through trackId.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])

  problems    Problem[]
  progress    LessonProgress[]
  quizAnswers QuizAnswer[]

  @@index([chapterId, order])
}

model Problem {
  id            String @id @default(cuid())
  slug          String @unique
  order         Int    @default(0)
  title         String
  difficulty    String @default("Easy")
  tagsCsv       String @default("")
  descriptionMd String @default("")
  examplesJson  String @default("[]") // [{input, output}]
  starterCode   String @default("")
  solutionCode  String @default("") // python: reference fn | sql: reference query
  functionName  String @default("") // python only
  testsJson     String @default("[]") // python only: [{args:[...], expected:...}]
  hintsJson     String @default("[]")
  xp            Int    @default(20)

  // "python" runs in Pyodide against testsJson; "sql" runs in sql.js against
  // sqlSetup, and is graded by diffing the result set with solutionCode's.
  kind     String  @default("python")
  sqlSetup String  @default("") // CREATE TABLE + INSERT, run on a fresh in-memory db
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  submissions Submission[]
  attempts    ProblemAttempt[]
  errorEvents ErrorEvent[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("in_progress") // in_progress | done
  // Set the first time the status becomes "done", and never moved afterwards —
  // re-reading a lesson should not rewrite when you finished it. NULL means the
  // row predates this column; the activity timeline skips those rather than
  // inventing a date for them.
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  problem   Problem  @relation(fields: [problemId], references: [id])

  // This is the busiest table in the app and it had no index at all. It is read
  // by userId on nearly every authed page render (the app layout, progress, the
  // streak, focus, rooms), and getStreak reads every passing row a student has
  // ever written. The first index serves the "have they solved this?" lookup in
  // /api/submit; the second serves the activity and streak scans.
  @@index([userId, problemId, passed])
  @@index([userId, createdAt])
}

// The work in progress on one problem — as opposed to Submission, which is the
// history of what was handed in.
//
// Three things a student loses today and should not:
//   1. their code. Close the tab mid-problem and the editor reopens on the
//      starter template, so the only way to keep work was to finish in one go.
//   2. the fact that they already solved it. Submission knows, but nothing on
//      the practice page reads it, so a returning student is shown a solved
//      problem with an empty editor and no reason to think they have been here.
//   3. how long it took. Every competitor shows this and it is the thing that
//      makes a second attempt feel like progress rather than repetition.
//
// One row per (student, problem), updated in place. It is deliberately not a
// log: the history lives in Submission and this is only "where was I".
model ProblemAttempt {
  id            String   @id @default(cuid())
  userId        String
  problemId     String
  draftCode     String
  // Set when the problem is first opened, so elapsed time survives a reload.
  startedAt     DateTime @default(now())
  // Seconds from first open to first pass. Null until solved, and never
  // overwritten afterwards — it is a personal best, not a running total.
  solvedSeconds Int?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  problem       Problem  @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
  @@index([userId, updatedAt])
}

// One answer to one end-of-lesson quiz question.
//
// These used to exist only in React state. A student answered eleven questions,
// saw which ones they got wrong, closed the tab, and every bit of it was gone —
// the single clearest signal the platform produces about whether a topic landed,
// thrown away eleven times per lesson. A practice problem tells you pass or fail;
// a quiz tells you *which* misunderstanding, because the wrong option they picked
// is itself the diagnosis.
//
// A log, not one row per (student, question), for the same reason Submission is
// a log: "got it wrong in March, right in May" is the thing worth knowing, and
// an upsert would erase exactly that. Volume is small — eleven questions per
// lesson, each locked after one pick.
//
// `question` is a snapshot for the reason Challenge.questions is one: lessons get
// edited constantly, so question 4 today is not question 4 next month. Without
// the text, a row would decay into an index into an array that has since moved.
//
// `correct` is derived on the server from the lesson's own content — never taken
// from the request body. Nothing is paid for a right answer, so there is no
// incentive to lie, but a client-supplied verdict would still quietly corrupt the
// one record we have of what this student actually understands.
model QuizAnswer {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  qIndex    Int
  question  String   @default("")
  chosen    Int
  correct   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  lesson    Lesson   @relation(fields: [lessonId], references: [id])

  // Serves "how did this student do on this lesson", the per-topic weakness
  // rollup, and the recent-activity scan respectively.
  @@index([userId, lessonId])
  @@index([userId, correct])
  @@index([userId, createdAt])
}

// One time a student hit an error we could explain.
//
// lib/error-help.ts already classifies a raw traceback into one of its rules —
// that work happened in the browser, was shown to the student, and was then
// dropped on the floor. This keeps the classification.
//
// Deliberately stores the rule id and not the traceback. A traceback carries the
// student's own variable names and values, is unbounded in length, and is
// writable by anyone logged in; the rule id is a short value from a fixed set,
// checked against that set before it is written. Everything a "you keep hitting
// indentation errors" feature needs is in the id, and none of what it does not
// need is kept.
model ErrorEvent {
  id         String   @id @default(cuid())
  userId     String
  rule       String
  dialect    String   @default("python")
  // Where it happened. Both optional: a runnable example inside a lesson has no
  // problem, and the practice workbench has no lesson.
  problemId  String?
  lessonSlug String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  problem    Problem? @relation(fields: [problemId], references: [id])

  @@index([userId, rule])
  @@index([userId, createdAt])
}

// A challenge: a fixed set of quiz questions, taken by two or more people and
// compared.
//
// This is the async half of the Battle Arena in docs/PRD chapter 5. The
// competitive part of that chapter — matchmaking, live rooms, spectators —
// needs concurrent players, and the platform has two students who have ever
// opened a lesson. Simultaneity is what makes a battle hard to build; it is not
// what makes it worth building. Take the same questions, compare the scores,
// see where you went wrong: that is the whole learning value, and it works with
// nobody else online.
//
// `questions` is a **snapshot**, not a set of references. Lessons get edited —
// this file has rewritten sixty of them — and a challenge whose questions
// changed underneath it would no longer be the same test for both players.
// Fairness here means the bytes are frozen at creation.
model Challenge {
  id        String             @id @default(cuid())
  code      String             @unique
  creatorId String
  title     String
  questions String
  createdAt DateTime           @default(now())
  creator   User               @relation(fields: [creatorId], references: [id])
  attempts  ChallengeAttempt[]

  @@index([creatorId, createdAt])
}

// One scored run. The unique constraint is the anti-cheat: without it the
// second player retries until they win, and the comparison means nothing.
// Practising the questions again is what the lessons are for.
model ChallengeAttempt {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  correct     Int
  total       Int
  seconds     Int
  answersJson String
  createdAt   DateTime  @default(now())
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([challengeId, userId])
  @@index([userId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  topic     String   @default("General")
  title     String
  body      String   @default("")
  code      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Beta feedback captured in-app, so testers' reports land in one place instead
// of scattering across WhatsApp. Written by /api/feedback; read on /feedback by
// the admin account (ADMIN_EMAIL). No email service involved.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("other") // "bug" | "idea" | "other"
  message   String
  path      String   @default("") // the page they were on when reporting
  status    String   @default("new") // "new" | "seen" — for triage
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Study Together — focus sessions, rooms, notebook.
//
// The timer is never "ticked" by a server. A room stores which phase it's in
// and when that phase started; every client derives the remaining time from the
// wall clock (lib/focus.ts). The poll endpoint advances the phase lazily when it
// notices the current one has run out. So there's no cron job, no socket server,
// and a tab that was asleep for ten minutes comes back to the correct time
// instead of a drifted one.
// ---------------------------------------------------------------------------

// One sitting of focused study — solo, or attached to a room.
model StudySession {
  id           String  @id @default(cuid())
  userId       String
  roomId       String?
  topic        String  @default("General")
  goal         String  @default("")
  // Minutes per phase, copied at start so changing a room's settings later
  // doesn't rewrite history.
  focusMinutes Int     @default(30)
  breakMinutes Int     @default(5)

  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  // Set on each heartbeat. Active time accrues from the gap between beats, so
  // the client reports only "I'm still here" and never how long it was here —
  // otherwise a focus score would be worth exactly as much as the honesty of
  // whoever opened devtools.
  lastBeatAt     DateTime  @default(now())
  // Wall-clock seconds the session was open, vs seconds this user was actually
  // present and interacting. focusPct is derived from these two, never stored.
  elapsedSeconds Int       @default(0)
  activeSeconds  Int       @default(0)
  cyclesDone     Int       @default(0)
  problemsSolved Int       @default(0)
  messagesUsed   Int       @default(0)

  user     User            @relation(fields: [userId], references: [id])
  room     Room?           @relation(fields: [roomId], references: [id])
  notebook NotebookEntry[]

  @@index([userId, startedAt])
}

// A private doubt. Written during focus so it doesn't interrupt anyone; the
// student can push it to the room's discussion queue when the break starts.
// The queue is just the rows where queued = true — it needs no model of its own.
model NotebookEntry {
  id        String    @id @default(cuid())
  userId    String
  sessionId String?
  roomId    String?
  text      String
  resolved  Boolean   @default(false)
  queued    Boolean   @default(false) // in the room's discussion queue
  queuedAt  DateTime? // queue order; null when not queued
  createdAt DateTime  @default(now())

  user    User          @relation(fields: [userId], references: [id])
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    Room?         @relation(fields: [roomId], references: [id])

  @@index([userId, createdAt])
  @@index([roomId, queued])
}

model Room {
  id              String  @id @default(cuid())
  code            String  @unique // invite code, e.g. "PY-4K2M"
  name            String
  subject         String  @default("Python")
  topic           String  @default("")
  maxParticipants Int     @default(4) // spec: 2-6
  isPublic        Boolean @default(false)
  hostId          String

  focusMinutes Int @default(30)
  breakMinutes Int @default(5)

  // The whole timer, in three fields. See the note above.
  phase          String   @default("focus") // focus | discussion | ended
  phaseStartedAt DateTime @default(now())
  cycle          Int      @default(1)

  // Host switch for the voice call. Off means nobody can join or stay in it.
  voiceEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  endedAt   DateTime?

  host     User            @relation("RoomHost", fields: [hostId], references: [id])
  members  RoomMember[]
  messages RoomMessage[]
  sessions StudySession[]
  notebook NotebookEntry[]
  signals  RoomSignal[]

  @@index([isPublic, endedAt])
}

model RoomMember {
  id     String @id @default(cuid())
  roomId String
  userId String

  joinedAt      DateTime @default(now())
  // Presence is derived from this: no heartbeat for a while = "away".
  // Nothing needs to push a leave event; a closed tab simply stops beating.
  lastSeenAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  status        String   @default("studying") // studying | away | left
  handRaised    Boolean  @default(false)
  needsHelp     Boolean  @default(false)
  messagesUsed  Int      @default(0)

  // Voice call. inVoice = this member has the call open; micMuted is their own
  // switch, mirrored here only so everyone else can render a muted icon.
  inVoice  Boolean @default(false)
  micMuted Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

// Deliberately not a chat log. Quick preset replies and emoji only, and the
// per-cycle budget is enforced server-side in the room's action route.
model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  kind      String   @default("quick") // quick | emoji
  text      String
  cycle     Int      @default(1)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, createdAt])
}

// WebRTC signalling, carried on the room's existing 2.5s poll instead of a
// socket server — that is what keeps voice at zero infrastructure cost.
//
// One row per offer/answer, not per ICE candidate: the browser gathers all its
// candidates first and ships them inside the SDP (non-trickle). Trickling over
// a 2.5s poll would take half a minute to connect; this takes two polls.
// Rows are deleted the moment their recipient collects them.
model RoomSignal {
  id      String @id @default(cuid())
  roomId  String
  fromId  String
  toId    String
  kind    String // offer | answer | bye
  payload String // the SDP, with candidates already embedded

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, toId, createdAt])
}
