// DataQuest — data model
// A data-science learning platform: tracks (phases) -> lessons -> problems,
// with real per-user progress, submissions, XP and streaks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @default("")
  role         String   @default("Aspiring Data Analyst")
  xp           Int      @default(0)
  // No streak column. It was a seeded constant nothing ever wrote to: the demo
  // account showed 12 days against three submissions, and every real signup was
  // told to keep its "0-day streak" alive forever. Derived from submissions in
  // lib/progress.ts now, exactly like Track.status was.
  createdAt    DateTime @default(now())

  // Onboarding. All optional — a student who skips still gets an account.
  gender       String?  // "male" | "female" | "unspecified"
  institution  String?  // class or college, free text
  interestsCsv String   @default("")
  language     String   @default("en") // stated preference; no content varies by it yet
  onboardedAt  DateTime?
  welcomedAt   DateTime? // set the first time the welcome plays, so it plays once

  lessonProgress LessonProgress[]
  submissions    Submission[]
  notes          Note[]
  sessions       StudySession[]
  notebook       NotebookEntry[]
  roomMembers    RoomMember[]
  roomMessages   RoomMessage[]
  hostedRooms    Room[]           @relation("RoomHost")
  feedback       Feedback[]
}

model Track {
  id         String  @id @default(cuid())
  slug       String  @unique
  order      Int
  title      String
  subtitle   String
  icon       String  @default("Py")
  whyText    String  @default("")
  weeks      String  @default("")
  level      String  @default("Beginner")
  milestone  String  @default("")
  toolsCsv   String  @default("")
  // Just the syllabus skill names: ["Variables", "Loops", ...]. Whether a skill is
  // done, and whether a track is done/now/locked, are per-user and derived in
  // lib/progress.ts. They used to be stored here, which meant every user saw the
  // same seeded "Python done, 33% job-ready" regardless of what they'd actually done.
  skillsJson String  @default("[]")
  checkpoint String? // e.g. "Data Analyst · ₹4-8 LPA"

  lessons  Lesson[]
  chapters Chapter[]
}

// The level the vision requires and the schema did not have:
// Subject -> Chapter -> Topic -> { lesson, visualization, quiz, problems }.
// See docs/ARCHITECTURE.md. `Track` is the Subject in all but name, and
// `Lesson` is the Topic.
//
// Added additively on purpose. Lesson.chapterId is nullable and Lesson.trackId
// stays, so every existing page keeps working untouched and no student's
// progress moves. Chapters can then be split for real, one subject at a time,
// instead of in one risky rewrite.
// Onboarding answers (docs/LEARNING-SPEC.md §5). All optional: a student who
// skips the questions still gets an account and a neutral welcome.
//
// `gender` is one of "male" | "female" | "unspecified" — "prefer not to say" is
// a real choice with its own welcome, not a missing answer.
// `welcomedAt` is what makes the welcome play exactly once, ever.

model Chapter {
  id      String @id @default(cuid())
  slug    String @unique
  order   Int
  title   String
  summary String @default("")
  trackId String
  track   Track  @relation(fields: [trackId], references: [id])

  lessons Lesson[]

  @@index([trackId, order])
}

model Lesson {
  id          String @id @default(cuid())
  slug        String @unique
  order       Int
  title       String
  minutes     Int    @default(10)
  level       String @default("Beginner")
  contentJson String @default("[]") // ordered content blocks
  trackId     String
  track       Track  @relation(fields: [trackId], references: [id])

  // Nullable while chapters are introduced subject by subject. A lesson with no
  // chapter yet still belongs to its subject through trackId.
  chapterId String?
  chapter   Chapter? @relation(fields: [chapterId], references: [id])

  problems Problem[]
  progress LessonProgress[]

  @@index([chapterId, order])
}

model Problem {
  id            String @id @default(cuid())
  slug          String @unique
  order         Int    @default(0)
  title         String
  difficulty    String @default("Easy")
  tagsCsv       String @default("")
  descriptionMd String @default("")
  examplesJson  String @default("[]") // [{input, output}]
  starterCode   String @default("")
  solutionCode  String @default("") // python: reference fn | sql: reference query
  functionName  String @default("") // python only
  testsJson     String @default("[]") // python only: [{args:[...], expected:...}]
  hintsJson     String @default("[]")
  xp            Int    @default(20)

  // "python" runs in Pyodide against testsJson; "sql" runs in sql.js against
  // sqlSetup, and is graded by diffing the result set with solutionCode's.
  kind     String  @default("python")
  sqlSetup String  @default("") // CREATE TABLE + INSERT, run on a fresh in-memory db
  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  submissions Submission[]
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  status   String @default("in_progress") // in_progress | done
  user     User   @relation(fields: [userId], references: [id])
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Submission {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  code      String
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  problem   Problem  @relation(fields: [problemId], references: [id])

  // This is the busiest table in the app and it had no index at all. It is read
  // by userId on nearly every authed page render (the app layout, progress, the
  // streak, focus, rooms), and getStreak reads every passing row a student has
  // ever written. The first index serves the "have they solved this?" lookup in
  // /api/submit; the second serves the activity and streak scans.
  @@index([userId, problemId, passed])
  @@index([userId, createdAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  topic     String   @default("General")
  title     String
  body      String   @default("")
  code      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Beta feedback captured in-app, so testers' reports land in one place instead
// of scattering across WhatsApp. Written by /api/feedback; read on /feedback by
// the admin account (ADMIN_EMAIL). No email service involved.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("other") // "bug" | "idea" | "other"
  message   String
  path      String   @default("") // the page they were on when reporting
  status    String   @default("new") // "new" | "seen" — for triage
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Study Together — focus sessions, rooms, notebook.
//
// The timer is never "ticked" by a server. A room stores which phase it's in
// and when that phase started; every client derives the remaining time from the
// wall clock (lib/focus.ts). The poll endpoint advances the phase lazily when it
// notices the current one has run out. So there's no cron job, no socket server,
// and a tab that was asleep for ten minutes comes back to the correct time
// instead of a drifted one.
// ---------------------------------------------------------------------------

// One sitting of focused study — solo, or attached to a room.
model StudySession {
  id           String  @id @default(cuid())
  userId       String
  roomId       String?
  topic        String  @default("General")
  goal         String  @default("")
  // Minutes per phase, copied at start so changing a room's settings later
  // doesn't rewrite history.
  focusMinutes Int     @default(30)
  breakMinutes Int     @default(5)

  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  // Set on each heartbeat. Active time accrues from the gap between beats, so
  // the client reports only "I'm still here" and never how long it was here —
  // otherwise a focus score would be worth exactly as much as the honesty of
  // whoever opened devtools.
  lastBeatAt     DateTime  @default(now())
  // Wall-clock seconds the session was open, vs seconds this user was actually
  // present and interacting. focusPct is derived from these two, never stored.
  elapsedSeconds Int       @default(0)
  activeSeconds  Int       @default(0)
  cyclesDone     Int       @default(0)
  problemsSolved Int       @default(0)
  messagesUsed   Int       @default(0)

  user     User            @relation(fields: [userId], references: [id])
  room     Room?           @relation(fields: [roomId], references: [id])
  notebook NotebookEntry[]

  @@index([userId, startedAt])
}

// A private doubt. Written during focus so it doesn't interrupt anyone; the
// student can push it to the room's discussion queue when the break starts.
// The queue is just the rows where queued = true — it needs no model of its own.
model NotebookEntry {
  id        String    @id @default(cuid())
  userId    String
  sessionId String?
  roomId    String?
  text      String
  resolved  Boolean   @default(false)
  queued    Boolean   @default(false) // in the room's discussion queue
  queuedAt  DateTime? // queue order; null when not queued
  createdAt DateTime  @default(now())

  user    User          @relation(fields: [userId], references: [id])
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    Room?         @relation(fields: [roomId], references: [id])

  @@index([userId, createdAt])
  @@index([roomId, queued])
}

model Room {
  id              String  @id @default(cuid())
  code            String  @unique // invite code, e.g. "PY-4K2M"
  name            String
  subject         String  @default("Python")
  topic           String  @default("")
  maxParticipants Int     @default(4) // spec: 2-6
  isPublic        Boolean @default(false)
  hostId          String

  focusMinutes Int @default(30)
  breakMinutes Int @default(5)

  // The whole timer, in three fields. See the note above.
  phase          String   @default("focus") // focus | discussion | ended
  phaseStartedAt DateTime @default(now())
  cycle          Int      @default(1)

  // Host switch for the voice call. Off means nobody can join or stay in it.
  voiceEnabled Boolean @default(true)

  createdAt DateTime  @default(now())
  endedAt   DateTime?

  host     User            @relation("RoomHost", fields: [hostId], references: [id])
  members  RoomMember[]
  messages RoomMessage[]
  sessions StudySession[]
  notebook NotebookEntry[]
  signals  RoomSignal[]

  @@index([isPublic, endedAt])
}

model RoomMember {
  id     String @id @default(cuid())
  roomId String
  userId String

  joinedAt      DateTime @default(now())
  // Presence is derived from this: no heartbeat for a while = "away".
  // Nothing needs to push a leave event; a closed tab simply stops beating.
  lastSeenAt    DateTime @default(now())
  activeSeconds Int      @default(0)
  status        String   @default("studying") // studying | away | left
  handRaised    Boolean  @default(false)
  needsHelp     Boolean  @default(false)
  messagesUsed  Int      @default(0)

  // Voice call. inVoice = this member has the call open; micMuted is their own
  // switch, mirrored here only so everyone else can render a muted icon.
  inVoice  Boolean @default(false)
  micMuted Boolean @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

// Deliberately not a chat log. Quick preset replies and emoji only, and the
// per-cycle budget is enforced server-side in the room's action route.
model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  kind      String   @default("quick") // quick | emoji
  text      String
  cycle     Int      @default(1)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, createdAt])
}

// WebRTC signalling, carried on the room's existing 2.5s poll instead of a
// socket server — that is what keeps voice at zero infrastructure cost.
//
// One row per offer/answer, not per ICE candidate: the browser gathers all its
// candidates first and ships them inside the SDP (non-trickle). Trickling over
// a 2.5s poll would take half a minute to connect; this takes two polls.
// Rows are deleted the moment their recipient collects them.
model RoomSignal {
  id      String @id @default(cuid())
  roomId  String
  fromId  String
  toId    String
  kind    String // offer | answer | bye
  payload String // the SDP, with candidates already embedded

  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, toId, createdAt])
}
