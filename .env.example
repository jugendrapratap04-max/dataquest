# Copy this file to `.env` and fill in the values.

# Local dev uses SQLite. On Vercel/production this becomes a Postgres URL.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. REQUIRED in production — the app refuses to boot
# without it, because a known secret lets anyone forge any user's session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
