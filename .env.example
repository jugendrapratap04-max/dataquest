# Copy this file to `.env` and fill in the values.

# Postgres — same engine locally and in production, so nothing works here and
# breaks there. Neon (neon.tech) free tier is what this is set up for; use a
# separate branch/database for local dev than the one Vercel points at.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs the session cookie. REQUIRED in production — the app refuses to boot
# without it, because a known secret lets anyone forge any user's session.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
